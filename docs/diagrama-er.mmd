        varchar imagen_url
        timestamp created_at
    }
    RESERVAS {
        bigint id PK
        bigint cliente_id FK
        bigint herramienta_id FK
        date fecha_inicio
        date fecha_fin
        varchar estado "PENDIENTE ... FINALIZADA, CANCELADA"
        timestamp created_at
        timestamp fecha_aceptacion
        timestamp fecha_entrega
        timestamp fecha_devolucion
        varchar estado_devolucion "BUENO, DANADO, PERDIDO"
        text observaciones_devolucion
    }
    PAGOS {
        bigint id PK
        bigint reserva_id FK
        decimal monto "tarifa x dias"
        varchar metodo_pago "TARJETA, TRANSFERENCIA, EFECTIVO"
        varchar estado_pago "COMPLETADO, REEMBOLSADO..."
        timestamp fecha_pago
    }
    FACTURAS {
        bigint id PK
        varchar numero UK "FAC-000001"
        bigint pago_id FK, UK
        bigint reserva_id FK
        bigint cliente_id FK
        varchar cliente_nombre "copia al facturar"
