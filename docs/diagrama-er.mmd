        bigint herramienta_id FK
        varchar herramienta_nombre
        date fecha_inicio
        date fecha_fin
        int dias
        decimal tarifa_diaria
        decimal subtotal
        decimal total
        varchar metodo_pago
        varchar estado "VIGENTE, ANULADA"
        timestamp fecha_emision
    }
    MANTENIMIENTOS {
        bigint id PK
        bigint herramienta_id FK
        bigint reserva_id FK "opcional"
        text descripcion_problema
        decimal costo_reparacion
        timestamp fecha_inicio
        timestamp fecha_fin "NULL = abierto"
    }
