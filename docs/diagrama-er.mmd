    ROLES {
        bigint id PK
        varchar nombre UK "ADMIN, PROVEEDOR, CLIENTE"
    }
    USUARIOS {
        bigint id PK
        varchar nombre
        varchar email UK
        varchar password "BCrypt"
        boolean activo
        timestamp created_at
        timestamp suspendido_hasta "fin de la suspensión"
        boolean baneado
        varchar motivo_sancion
    }
    USUARIO_ROLES {
        bigint usuario_id PK, FK
        bigint rol_id PK, FK
    }
    CATEGORIAS {
        bigint id PK
        varchar nombre UK
        text descripcion
    }
    HERRAMIENTAS {
        bigint id PK
        bigint proveedor_id FK
        bigint categoria_id FK
        varchar nombre
        text descripcion
        decimal tarifa_diaria "mayor que 0"
        varchar estado "DISPONIBLE, MANTENIMIENTO, FUERA_DE_SERVICIO"
        varchar imagen_url
        decimal deposito "lo fija el proveedor"
        timestamp created_at
    }
    RESERVAS {
        bigint id PK
        bigint cliente_id FK
        bigint herramienta_id FK
        date fecha_inicio
        date fecha_fin
        varchar estado "PENDIENTE ... FINALIZADA, CANCELADA"
        timestamp created_at
        timestamp fecha_aceptacion
        timestamp fecha_entrega
        timestamp fecha_devolucion
        varchar estado_devolucion "BUENO, DANADO, PERDIDO"
        text observaciones_devolucion
        bigint version "bloqueo optimista (@Version)"
        decimal deposito "garantía cobrada con el pago"
        varchar estado_deposito "RETENIDO, DEVUELTO..."
        int dias_retraso
        decimal multa_retraso
        decimal cargo_danos
        decimal deposito_devuelto
        decimal saldo_pendiente
    }
    CALIFICACIONES {
        bigint id PK
        bigint reserva_id FK,UK "una por alquiler"
        bigint cliente_id FK
        bigint herramienta_id FK
        bigint proveedor_id FK
        int estrellas_herramienta "1 a 5"
        int estrellas_proveedor "1 a 5"
        varchar comentario
        timestamp fecha
    }
    LISTA_ESPERA {
        bigint id PK
        bigint herramienta_id FK
        bigint cliente_id FK
        date fecha_inicio
        date fecha_fin
        varchar estado "ESPERANDO, NOTIFICADA..."
        timestamp creada_en "orden de la fila"
    }
    NOTIFICACIONES {
        bigint id PK
        bigint usuario_id FK
        varchar titulo
        varchar mensaje
        boolean leida
        timestamp creada_en
    }
    TOKENS_EMITIDOS {
        varchar jti PK "id único del JWT"
        bigint usuario_id FK
        timestamp emitido_en
        timestamp expira_en
    }
    TOKENS_REVOCADOS {
        varchar jti PK "lista negra"
        bigint usuario_id FK
        varchar motivo
        timestamp revocado_en
        timestamp expira_en
    }
    PAGOS {
        bigint id PK
        bigint reserva_id FK
        decimal monto "tarifa x dias"
        varchar metodo_pago "TARJETA, TRANSFERENCIA, EFECTIVO"
        varchar estado_pago "COMPLETADO, REEMBOLSADO..."
        timestamp fecha_pago
    }
    FACTURAS {
        bigint id PK
        varchar numero UK "FAC-000001"
        bigint pago_id FK, UK
        bigint reserva_id FK
        bigint cliente_id FK
        varchar cliente_nombre "copia al facturar"
        varchar cliente_email
        bigint herramienta_id FK
        varchar herramienta_nombre
        date fecha_inicio
        date fecha_fin
        int dias
        decimal tarifa_diaria
        decimal subtotal
        decimal total
        varchar metodo_pago
        varchar estado "VIGENTE, ANULADA"
        timestamp fecha_emision
        decimal deposito "+ copia de la liquidación (multa, daños, saldo)"
    }
    MANTENIMIENTOS {
        bigint id PK
        bigint herramienta_id FK
        bigint reserva_id FK "opcional"
        text descripcion_problema
        decimal costo_reparacion
        timestamp fecha_inicio
        timestamp fecha_fin "NULL = abierto"
    }
